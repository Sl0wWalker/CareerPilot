CAREERPILOT_ENVIRONMENT=development
CAREERPILOT_LOG_LEVEL=INFO
CAREERPILOT_DATABASE_URL=sqlite:///./data/careerpilot.db
CAREERPILOT_CORS_ORIGINS=["http://localhost:5173"]
CAREERPILOT_AI_PROVIDER=ollama
CAREERPILOT_AI_MODEL=qwen3:8b
CAREERPILOT_AI_EMBEDDING_MODEL=nomic-embed-text
CAREERPILOT_AI_BASE_URL=http://localhost:11434
# CAREERPILOT_AI_API_KEY=
CAREERPILOT_AI_TIMEOUT_SECONDS=60
CAREERPILOT_APP_VERSION=1.0.0
CAREERPILOT_AUTH_ENABLED=false
CAREERPILOT_SECRET_KEY=development-only-change-me
CAREERPILOT_ACCESS_TOKEN_MINUTES=60
CAREERPILOT_RATE_LIMIT_REQUESTS=120
CAREERPILOT_RATE_LIMIT_WINDOW_SECONDS=60
CAREERPILOT_BACKUP_DIRECTORY=./data/backups
CAREERPILOT_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
CAREERPILOT_METRICS_ENABLED=true
VITE_API_BASE_URL=http://127.0.0.1:8000
